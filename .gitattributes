# Normalize to LF in the repository, check out native on Windows.
* text=auto

*.rs      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.html    text eol=lf

# Files that are read by Linux. A CRLF here is not cosmetic: `#!/usr/bin/env
# bash\r` fails with "bad interpreter", and systemd rejects a unit whose
# directives carry a trailing carriage return.
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.lock    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.example text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf

# Read by PowerShell on Windows, where CRLF is native.
*.ps1     text eol=crlf

*.png     binary
*.ico     binary
*.icns    binary
