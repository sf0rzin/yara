# Drops tombstones nobody needs any more. Scheduled by yara-purge.timer,
# which is what gets enabled — not this.
#
# Without tombstones a delete on one machine is silently undone by the next
# sync from another. With them and no purge, the database only grows.
#
#   sudo install -m 0644 yara-purge.{service,timer} /etc/systemd/system/
#   sudo systemctl enable --now yara-purge.timer
#
# This used to be a hardened unit running the binary directly. It now reaches
# into the running container instead, because that is where the binary and the
# database live — and the sandbox went with them: the container drops every
# capability, runs read-only, and is denied private-network egress by
# deploy/egress-guard.sh. Re-stating a systemd sandbox around `docker` would
# describe the client, not the work.
#
# `exec` rather than `run`, so the purge opens the same SQLite file as the
# service rather than racing a second writer against it.

[Unit]
Description=Drop expired yara sync tombstones
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose -f /opt/yara/deploy/docker-compose.yml exec -T sync /usr/local/bin/yara-sync purge
