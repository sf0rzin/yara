{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yara",
  "version": "0.6.3",
  "identifier": "pro.yara.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yara",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFNEJGQUE2RUI2MUFEMTcKUldRWHJXSHJwdnBMUHFlU1hhLzJvclJVVzFwQ2Jic1ZyVy9Sd1kyU0JpdlY1VUJmKzZzVnZteEkK",
      "endpoints": [
        "https://yara.lat/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
